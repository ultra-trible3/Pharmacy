# Electron Forge refuses to package an app installed with pnpm's default
# isolated linker (it needs a flat node_modules to resolve the Electron binary
# and the app's runtime dependencies). This is the layout Forge documents for
# pnpm workspaces.
node-linker=hoisted

strict-peer-dependencies=false
auto-install-peers=true
resolution-mode=highest
enable-pre-post-scripts=true
